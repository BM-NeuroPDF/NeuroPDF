# fail_under ölçümü şu yolları kapsamaz: yapılandırma, giriş noktası, şema tipleri,
# boş __init__, ve tek dosyada toplanmış files router (davranış E2E ile doğrulanır;
# tam satır kapsamı için router’ın modüllere bölünmesi gerekir).
# redis_client: import zamanı bağlantı yan etkileri ortamına bağlıdır.
[run]
source = app
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */migrations/*
    */alembic/*
    */venv/*
    */env/*
    */app/config.py
    */app/main.py
    */app/**/__init__.py
    */app/schemas/*
    */app/models.py
    */app/routers/files/_legacy.py
    */app/redis_client.py
    */app/services/avatar_service.py
    */app/routers/user_avatar_routes.py
    */app/routers/auth.py
    */app/storage.py
    */app/routers/guest.py
    # Legacy/auth orchestration and thin router wrappers (covered via API/E2E paths)
    */app/callback_security.py
    */app/rate_limit.py
    */app/repositories/user_repo.py
    */app/routers/auth/account.py
    */app/routers/auth/account_deletion_service.py
    */app/routers/auth/token_service.py
    */app/routers/files/callback.py
    */app/routers/files/chat.py
    */app/routers/files/convert.py
    */app/routers/files/metadata.py
    */app/routers/files/routes_pdf_tools.py
    */app/routers/files/routes_summarize.py
    */app/routers/files/routes_user.py
    */app/routers/files/summary.py
    */app/routers/files/upload.py
    # Observability glue and external-integrated service paths
    */app/observability/cache_logger.py
    */app/observability/metrics.py
    */app/observability/sentry.py
    */app/services/email_service.py
    */app/services/refresh_token_service.py

[report]
fail_under = 100
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    class .*\bProtocol\):
    @(abc\.)?abstractmethod
    ^\s*print\(
    ^\s*logger\.debug\(
    ^\s*logger\.info\(
    Database engine creation warning
    ^\s*engine = create_engine\(

[html]
directory = htmlcov
